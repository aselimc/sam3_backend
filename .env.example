# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ── Auth (local profile) ────────────────────────────────────────────────────
# Static API key. Bootstrap script generates a random one if .env missing.
LOCAL_API_KEY=replace-me-with-random-32-byte-hex
WEBHOOK_SECRET=replace-me-with-random-32-byte-hex

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=178956970

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=sam3
POSTGRES_PASSWORD=sam3
POSTGRES_DB=sam3
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sam3:sam3@postgres:5432/sam3

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── S3 / MinIO ──────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_UPLOADS=sam3-uploads
S3_BUCKET_ARTIFACTS=sam3-artifacts
S3_FORCE_PATH_STYLE=true

# ── Worker ──────────────────────────────────────────────────────────────────
MODELS_ENABLED=sam3,depth_anything_v3
WORKER_PRELOAD=false
CUDA_VISIBLE_DEVICES=0

# ── Compose ─────────────────────────────────────────────────────────────────
# cpu | gpu1 | gpu2  — set by bootstrap_dev based on detected GPUs.
COMPOSE_PROFILES=cpu
